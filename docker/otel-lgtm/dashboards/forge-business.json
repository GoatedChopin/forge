      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [
        {
          "rawSql": "SELECT\n  CASE WHEN u.total_sessions <= 1 THEN 'New' ELSE 'Returning' END AS type,\n  COUNT(*) AS users\nFROM forge_signals_users u\nWHERE $__timeFilter(u.last_seen_at)\nGROUP BY 1",
          "format": "table",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
          "refId": "A"
