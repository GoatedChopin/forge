          "rawSql": "SELECT event_name, COUNT(*) AS count,\n  COUNT(DISTINCT user_id) AS users,\n  COUNT(DISTINCT session_id) AS sessions\nFROM forge_signals_events\nWHERE event_type = 'track' AND event_name IS NOT NULL\n  AND $__timeFilter(timestamp) ${bot_filter}\nGROUP BY event_name ORDER BY count DESC LIMIT 20",
          "format": "table",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
