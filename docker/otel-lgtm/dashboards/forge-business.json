      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [
        {
          "rawSql": "SELECT entry_page, COUNT(*) AS sessions,\n  ROUND(100.0 * COUNT(*) FILTER (WHERE is_bounce) / GREATEST(COUNT(*), 1), 1) AS bounce_pct,\n  ROUND(AVG(duration_secs)) AS avg_duration_s\nFROM forge_signals_sessions\nWHERE entry_page IS NOT NULL AND $__timeFilter(started_at) ${bot_filter}\nGROUP BY entry_page ORDER BY sessions DESC LIMIT 15",
