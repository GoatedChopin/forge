      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [
        {
          "rawSql": "SELECT utm_source, utm_medium, utm_campaign,\n  COUNT(*) AS sessions,\n  ROUND(100.0 * COUNT(*) FILTER (WHERE is_bounce) / GREATEST(COUNT(*), 1), 1) AS bounce_pct,\n  ROUND(AVG(duration_secs)) AS avg_duration_s\nFROM forge_signals_sessions\nWHERE utm_source IS NOT NULL AND $__timeFilter(started_at) ${bot_filter}\nGROUP BY utm_source, utm_medium, utm_campaign\nORDER BY sessions DESC LIMIT 20",
          "format": "table",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
