        {
          "rawSql": "SELECT entry_page, exit_page, COUNT(*) AS sessions,\n  ROUND(AVG(page_view_count)::numeric, 1) AS avg_pages,\n  ROUND(AVG(duration_secs)) AS avg_duration_s\nFROM forge_signals_sessions\nWHERE entry_page IS NOT NULL AND exit_page IS NOT NULL\n  AND $__timeFilter(started_at) ${bot_filter}\nGROUP BY entry_page, exit_page ORDER BY sessions DESC LIMIT 15",
