      "id": 15,
      "type": "table",
      "title": "Weekly Cohort Retention",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 33 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [
        {
          "rawSql": "SELECT cohort_week, weeks_since, active_users, cohort_size,\n  ROUND(100.0 * active_users / GREATEST(cohort_size, 1), 1) AS retention_pct\nFROM forge_signals_retention\nWHERE cohort_week >= $__timeFrom()::date\nORDER BY cohort_week, weeks_since",
          "format": "table",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
