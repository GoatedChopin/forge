          "rawSql": "SELECT function_name, COUNT(DISTINCT user_id) AS unique_users\nFROM forge_signals_events\nWHERE event_type = 'rpc_call' AND function_name IS NOT NULL AND user_id IS NOT NULL\n  AND $__timeFilter(timestamp) ${bot_filter}\nGROUP BY function_name ORDER BY unique_users DESC LIMIT 10",
