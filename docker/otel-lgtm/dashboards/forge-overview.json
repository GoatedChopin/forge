{
  "annotations": { "list": [] },
  "description": "Service health, request traffic, function performance, background jobs, database connections, traces, and logs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Service Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Request Rate",
      "description": "Total HTTP requests per second across all routes.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#73BF69", "value": null }
          ]}
        }
      },
      "options": { "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "expr": "sum(rate(http_requests_total{service_name=~\"$service_name\"}[$__rate_interval]))",
        "legendFormat": "req/s"
      }]
    },
    {
      "type": "stat",
      "title": "P95 Latency",
      "description": "95th percentile response time across all routes.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#73BF69", "value": null },
            { "color": "#FF9830", "value": 0.3 },
            { "color": "#F2495C", "value": 1 }
          ]}
        }
      },
      "options": { "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service_name=~\"$service_name\"}[$__rate_interval])) by (le))"
      }]
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "description": "Percentage of requests returning 5xx status codes.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#73BF69", "value": null },
            { "color": "#FF9830", "value": 0.01 },
            { "color": "#F2495C", "value": 0.05 }
          ]},
          "noValue": "0%"
        }
      },
      "options": { "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "expr": "sum(rate(http_requests_total{service_name=~\"$service_name\",status=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_total{service_name=~\"$service_name\"}[$__rate_interval]))"
      }]
    },
    {
      "type": "stat",
      "title": "Functions / sec",
      "description": "Total function executions (queries + mutations) per second.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "#8AB8FF", "value": null }] }
        }
      },
      "options": { "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "expr": "sum(rate(fn_executions_total{service_name=~\"$service_name\"}[$__rate_interval]))"
      }]
    },
    {
      "type": "stat",
      "title": "DB Active",
      "description": "Active database connections currently in use.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#73BF69", "value": null },
            { "color": "#FF9830", "value": 40 },
            { "color": "#F2495C", "value": 48 }
          ]}
        }
      },
      "options": { "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "expr": "db_client_connection_count{service_name=~\"$service_name\"}",
        "legendFormat": "active"
      }]
    },
    {
      "type": "stat",
      "title": "Live Clients",
      "description": "Active SSE subscription connections.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "#B877D9", "value": null }] },
          "noValue": "0"
        }
      },
      "options": { "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "expr": "active_connections{service_name=~\"$service_name\",type=\"sse\"}"
      }]
    },

    {
      "type": "row",
      "title": "HTTP Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Request Rate by Route",
      "description": "Requests per second broken down by HTTP route.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "lineInterpolation": "smooth"
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [{
        "expr": "sum by (path) (rate(http_requests_total{service_name=~\"$service_name\"}[$__rate_interval]))",
        "legendFormat": "{{path}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Response Latency (p50 / p95 / p99)",
      "description": "Latency percentiles aggregated across all routes. Spikes in p99 often indicate outlier queries or lock contention.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "p50.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "p95.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "p99.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses by Status Code",
      "description": "HTTP response distribution. Green is healthy, orange is client errors (auth failures, bad input), red is server errors.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal" },
            "showPoints": "never"
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "2.." }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "3.." }, "properties": [{ "id": "color", "value": { "fixedColor": "#8AB8FF", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "4.." }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "5.." }, "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [{
        "expr": "sum by (status) (rate(http_requests_total{service_name=~\"$service_name\"}[$__rate_interval]))",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Latency by Route (p95)",
      "description": "Per-route p95 latency. Identifies which routes are slow.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth"
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
        "legendFormat": "{{path}}"
      }]
    },

    {
      "type": "row",
      "title": "Functions",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Function Execution Rate",
      "description": "Executions per second for each registered function (queries and mutations).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth"
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [{
        "expr": "sum by (function) (rate(fn_executions_total{service_name=~\"$service_name\"}[$__rate_interval]))",
        "legendFormat": "{{function}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Function Latency (p95)",
      "description": "95th percentile execution time per function. Slow functions are candidates for caching or optimization.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth"
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, function) (rate(fn_duration_seconds_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
        "legendFormat": "{{function}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Function Errors",
      "description": "Failed function executions per second. Sustained errors here usually mean a query or mutation is throwing.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "showPoints": "never",
            "lineWidth": 1
          },
          "color": { "mode": "fixed", "fixedColor": "#F2495C" }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      },
      "targets": [{
        "expr": "sum by (function) (rate(fn_executions_total{service_name=~\"$service_name\",status=\"error\"}[$__rate_interval]))",
        "legendFormat": "{{function}}"
      }]
    },
    {
      "type": "piechart",
      "title": "Function Mix",
      "description": "Proportion of traffic by function type (query vs mutation).",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 31 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "query" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "mutation" }, "properties": [{ "id": "color", "value": { "fixedColor": "#8AB8FF", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "list", "placement": "bottom", "values": ["percent"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [{
        "expr": "sum by (kind) (rate(fn_executions_total{service_name=~\"$service_name\"}[$__rate_interval]))",
        "legendFormat": "{{kind}}"
      }]
    },
    {
      "type": "table",
      "title": "Slowest Functions",
      "description": "Functions ranked by average execution time over the selected period.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 31 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Function" }, "properties": [{ "id": "custom.width", "value": 160 }] },
          { "matcher": { "id": "byName", "options": "Avg Duration" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 }, { "id": "custom.width", "value": 100 }] },
          { "matcher": { "id": "byName", "options": "Calls" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }, { "id": "custom.width", "value": 80 }] },
          { "matcher": { "id": "byName", "options": "Time" }, "properties": [{ "id": "custom.hidden", "value": true }] }
        ]
      },
      "options": {
        "sortBy": [{ "displayName": "Avg Duration", "desc": true }],
        "footer": { "enablePagination": false }
      },
      "transformations": [
        { "id": "joinByField", "options": { "byField": "function", "mode": "outer" } },
        { "id": "organize", "options": {
          "renameByName": { "function": "Function", "Value #A": "Avg Duration", "Value #B": "Calls" }
        }}
      ],
      "targets": [
        {
          "expr": "sum by (function) (rate(fn_duration_seconds_sum{service_name=~\"$service_name\"}[$__rate_interval])) / sum by (function) (rate(fn_duration_seconds_count{service_name=~\"$service_name\"}[$__rate_interval]))",
          "legendFormat": "{{function}}",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "sum by (function) (increase(fn_executions_total{service_name=~\"$service_name\"}[$__range]))",
          "legendFormat": "{{function}}",
          "instant": true,
          "format": "table",
          "refId": "B"
        }
      ]
    },

    {
      "type": "row",
      "title": "Background Jobs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "collapsed": true,
      "panels": [
        {
          "type": "timeseries",
          "title": "Job Execution Rate",
          "description": "Background job completions per second, broken down by job type and outcome.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
          "datasource": { "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "custom": {
                "drawStyle": "line",
                "lineWidth": 2,
                "fillOpacity": 15,
                "gradientMode": "opacity",
                "showPoints": "never",
                "spanNulls": true,
                "lineInterpolation": "smooth"
              }
            }
          },
          "options": {
            "tooltip": { "mode": "multi", "sort": "desc" },
            "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "sum"] }
          },
          "targets": [{
            "expr": "sum by (job_type, status) (rate(job_executions_total{service_name=~\"$service_name\"}[$__rate_interval]))",
            "legendFormat": "{{job_type}} ({{status}})"
          }]
        },
        {
          "type": "timeseries",
          "title": "Job Duration (p95)",
          "description": "95th percentile execution time per job type.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
          "datasource": { "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
                "lineWidth": 2,
                "fillOpacity": 10,
                "gradientMode": "opacity",
                "showPoints": "never",
                "spanNulls": true,
                "lineInterpolation": "smooth"
              }
            }
          },
          "options": {
            "tooltip": { "mode": "multi", "sort": "desc" },
            "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
          },
          "targets": [{
            "expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(job_duration_seconds_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
            "legendFormat": "{{job_type}}"
          }]
        }
      ]
    },

    {
      "type": "row",
      "title": "Database",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Connection Pool",
      "description": "Active, idle, and max database connections. When active approaches max, queries start queuing.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Active" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Idle" }, "properties": [{ "id": "color", "value": { "fixedColor": "#8AB8FF", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Max" }, "properties": [
            { "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } },
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
            { "id": "custom.fillOpacity", "value": 0 }
          ]}
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        { "expr": "db_client_connection_count{service_name=~\"$service_name\"}", "legendFormat": "Active" },
        { "expr": "db_client_connection_idle_count{service_name=~\"$service_name\"}", "legendFormat": "Idle" },
        { "expr": "db_client_connection_max{service_name=~\"$service_name\"}", "legendFormat": "Max" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Query Duration (p50 / p95)",
      "description": "Database operation latency. Sustained high p95 may indicate missing indexes or lock contention.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(db_client_operation_duration_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_client_operation_duration_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },

    {
      "type": "row",
      "title": "Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "collapsed": false
    },
    {
      "type": "table",
      "title": "Recent Requests",
