{
  "description": "Backend health, latency, errors, logs, traces, and frontend diagnostics.",
  "editable": true, "schemaVersion": 39, "tags": ["forge", "operations"],
  "time": { "from": "now-1h", "to": "now" }, "refresh": "10s",
  "timezone": "browser", "title": "Forge Operations", "uid": "forge-ops",
  "panels": [
    { "type": "row", "title": "Service Health", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "stat", "title": "Request Rate (rpm)", "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "targets": [{ "rawSql": "SELECT (count(*)::float / GREATEST(EXTRACT(EPOCH FROM NOW() - (NOW() - INTERVAL '5 minutes')) / 60, 1))::numeric(10,1) AS \"val\" FROM forge_signals_events WHERE timestamp > NOW() - INTERVAL '5 minutes' AND event_type = 'rpc_call'", "format": "table", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Error Rate", "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":5}] } } },
      "targets": [{ "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 0 ELSE (100.0 * count(*) FILTER (WHERE status = 'error') / count(*))::numeric(5,2) END AS \"val\" FROM forge_signals_events WHERE $__timeFilter(timestamp) AND event_type = 'rpc_call'", "format": "table", "refId": "A" }]
    },
    {
      "type": "stat", "title": "p95 Latency", "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":100},{"color":"red","value":500}] } } },
      "targets": [{ "rawSql": "SELECT PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY duration_ms)::numeric(10,1) AS \"val\" FROM forge_signals_events WHERE $__timeFilter(timestamp) AND event_type = 'rpc_call' AND duration_ms IS NOT NULL", "format": "table", "refId": "A" }]
    },
    {
      "type": "stat", "title": "DB Connections", "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0" } },
      "targets": [{ "expr": "db_client_connection_count or vector(0)", "refId": "A" }]
    },
    {
      "type": "stat", "title": "SSE Sessions", "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "targets": [{ "rawSql": "SELECT count(*) AS \"val\" FROM forge_sessions WHERE status = 'connected'", "format": "table", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Nodes", "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "targets": [{ "rawSql": "SELECT count(*) AS \"val\" FROM forge_nodes WHERE status = 'active'", "format": "table", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Frontend Errors", "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" }, "noValue": "0" } },
      "targets": [{ "rawSql": "SELECT count(*) AS \"val\" FROM forge_signals_events WHERE $__timeFilter(timestamp) AND event_type = 'error'", "format": "table", "refId": "A" }]
    },

    { "type": "row", "title": "Request Performance", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },
    {
      "type": "timeseries", "title": "RPC Calls / min", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15 } } },
      "targets": [{ "rawSql": "SELECT date_trunc('minute', timestamp) AS time, count(*) AS \"calls\" FROM forge_signals_events WHERE $__timeFilter(timestamp) AND event_type = 'rpc_call' GROUP BY 1 ORDER BY 1", "format": "time_series", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "RPC Latency (avg / p95)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 5 } } },
      "targets": [
        { "rawSql": "SELECT date_trunc('minute', timestamp) AS time, avg(duration_ms)::numeric(10,1) AS \"avg\" FROM forge_signals_events WHERE $__timeFilter(timestamp) AND event_type = 'rpc_call' AND duration_ms IS NOT NULL GROUP BY 1 ORDER BY 1", "format": "time_series", "refId": "A" },
        { "rawSql": "SELECT date_trunc('minute', timestamp) AS time, PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY duration_ms)::numeric(10,1) AS \"p95\" FROM forge_signals_events WHERE $__timeFilter(timestamp) AND event_type = 'rpc_call' AND duration_ms IS NOT NULL GROUP BY 1 ORDER BY 1", "format": "time_series", "refId": "B" }
      ]
    },

    { "type": "row", "title": "Functions & Infrastructure", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 } },
    {
      "type": "barchart", "title": "Slowest Functions (avg ms)", "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "options": { "orientation": "horizontal" },
      "targets": [{ "rawSql": "SELECT function_name AS \"Function\", avg(duration_ms)::numeric(10,1) AS \"Avg ms\", PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY duration_ms)::numeric(10,1) AS \"p95 ms\" FROM forge_signals_events WHERE $__timeFilter(timestamp) AND event_type = 'rpc_call' AND function_name IS NOT NULL AND duration_ms IS NOT NULL GROUP BY function_name ORDER BY \"Avg ms\" DESC LIMIT 10", "format": "table", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Database Connections", "gridPos": { "h": 7, "w": 6, "x": 12, "y": 15 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "db_client_connection_count", "legendFormat": "active", "refId": "A" },
        { "expr": "db_client_connection_idle_count", "legendFormat": "idle", "refId": "B" },
        { "expr": "db_client_connection_max", "legendFormat": "max", "refId": "C" }
      ]
    },
    {
      "type": "table", "title": "Cluster Nodes", "gridPos": { "h": 7, "w": 6, "x": 18, "y": 15 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "targets": [{ "rawSql": "SELECT hostname AS \"Host\", status AS \"Status\", array_to_string(roles, ', ') AS \"Roles\", current_connections AS \"Conns\" FROM forge_nodes ORDER BY CASE WHEN status = 'active' THEN 0 ELSE 1 END, started_at DESC LIMIT 10", "format": "table", "refId": "A" }]
    },

    { "type": "row", "title": "Errors & Diagnostics", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 } },
    {
      "type": "timeseries", "title": "Error Trend", "gridPos": { "h": 6, "w": 12, "x": 0, "y": 23 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" }, "custom": { "fillOpacity": 20 } } },
      "targets": [{ "rawSql": "SELECT date_trunc('minute', timestamp) AS time, count(*) AS \"errors\" FROM forge_signals_events WHERE $__timeFilter(timestamp) AND error_message IS NOT NULL GROUP BY 1 ORDER BY 1", "format": "time_series", "refId": "A" }]
    },
    {
      "type": "table", "title": "Top Errors", "gridPos": { "h": 6, "w": 12, "x": 12, "y": 23 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "targets": [{ "rawSql": "SELECT error_message AS \"Error\", count(*) AS \"Count\", count(DISTINCT session_id) AS \"Sessions\", max(timestamp) AS \"Last Seen\" FROM forge_signals_events WHERE $__timeFilter(timestamp) AND error_message IS NOT NULL GROUP BY error_message ORDER BY \"Count\" DESC LIMIT 15", "format": "table", "refId": "A" }]
    },
    {
      "type": "table", "title": "Recent Frontend Errors", "gridPos": { "h": 7, "w": 24, "x": 0, "y": 29 },
      "datasource": { "uid": "forge_pg", "type": "grafana-postgresql-datasource" },
      "targets": [{ "rawSql": "SELECT timestamp AS \"Time\", error_message AS \"Error\", coalesce(function_name, '-') AS \"Fn\", coalesce(correlation_id, '-') AS \"Corr ID\", coalesce(page_url, '-') AS \"Page\", coalesce(user_id::text, '-') AS \"User\" FROM forge_signals_events WHERE $__timeFilter(timestamp) AND event_type = 'error' ORDER BY timestamp DESC LIMIT 30", "format": "table", "refId": "A" }]
    },

    { "type": "row", "title": "Logs", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 } },
    {
      "type": "logs", "title": "Application Logs", "gridPos": { "h": 12, "w": 24, "x": 0, "y": 37 },
      "datasource": { "uid": "loki" },
      "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [{ "expr": "{service_name=~\".+\"}", "refId": "A" }]
    },

    { "type": "row", "title": "Traces", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 } },
    {
      "type": "table", "title": "Recent Traces", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 50 },
      "datasource": { "uid": "tempo" },
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "traceID" }, "properties": [{ "id": "custom.width", "value": 140 }, { "id": "links", "value": [{ "title": "View", "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"queryType\":\"traceql\",\"query\":\"${__value.raw}\"}]}" }] }] },
          { "matcher": { "id": "byName", "options": "traceName" }, "properties": [{ "id": "custom.width", "value": 180 }] },
          { "matcher": { "id": "byName", "options": "startTime" }, "properties": [{ "id": "custom.width", "value": 130 }] },
          { "matcher": { "id": "byName", "options": "rootServiceName" }, "properties": [{ "id": "custom.width", "value": 120 }] },
          { "matcher": { "id": "byName", "options": "duration" }, "properties": [{ "id": "custom.width", "value": 70 }, { "id": "unit", "value": "ns" }] }
        ]
      },
      "targets": [{ "queryType": "nativeSearch", "limit": 20, "serviceName": "forge-svelte-demo-template", "refId": "A" }]
    }
  ]
}
