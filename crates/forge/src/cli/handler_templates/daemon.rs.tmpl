// Context API: ctx.is_shutdown_requested() -> bool, ctx.db(). Honour shutdown to allow graceful stop.
// Daemons run continuously and auto-restart on failure.

#[allow(unused_imports)]
use forge::prelude::*;
use std::time::Duration;

#[forge::daemon]
pub async fn {{name}}(ctx: &DaemonContext) -> Result<()> {
    while !ctx.is_shutdown_requested() {
        // TODO: do one unit of work, then sleep
        tokio::time::sleep(Duration::from_secs(5)).await;
    }
    Ok(())
}
