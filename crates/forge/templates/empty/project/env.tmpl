# Database
DATABASE_URL=postgres://postgres:forge@localhost:5432/{{project_name}}

# Server
HOST=0.0.0.0
PORT=8080
# Log levels: error, warn, info, debug, trace
# Default shows INFO + function access logs at TRACE
RUST_LOG=info,forge_runtime::function::executor=trace

# Postgres (used by docker-compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=forge
POSTGRES_DB={{project_name}}

# Optional: JWT secret for authentication
# FORGE_SECRET=your-secret-key-here
