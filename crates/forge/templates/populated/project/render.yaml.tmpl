# Render Blueprint
# https://render.com/docs/blueprint-spec

services:
  - type: web
    name: {{name}}
    runtime: docker
    dockerfilePath: ./Dockerfile
    healthCheckPath: /health
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: {{name}}-db
          property: connectionString
      - key: RUST_LOG
        value: info
      - key: FORGE_ENV
        value: production

databases:
  - name: {{name}}-db
    plan: starter
    databaseName: {{name}}
    user: {{name}}
