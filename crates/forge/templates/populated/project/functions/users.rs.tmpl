use crate::schema::{User, UserRole};
use forge::prelude::*;

/// List all users with reactive subscription support
#[forge::query(cache = "30s", public)]
pub async fn get_users(ctx: &QueryContext) -> Result<Vec<User>> {
    sqlx::query_as::<_, User>("SELECT * FROM users ORDER BY created_at DESC")
        .fetch_all(ctx.db())
        .await
        .map_err(Into::into)
}

/// Get single user by ID
#[forge::query(timeout = 10, public)]
pub async fn get_user(ctx: &QueryContext, id: Uuid) -> Result<Option<User>> {
    sqlx::query_as::<_, User>("SELECT * FROM users WHERE id = $1")
        .bind(id)
        .fetch_optional(ctx.db())
        .await
        .map_err(Into::into)
}

/// Create a new user
#[forge::mutation(public)]
pub async fn create_user(
    ctx: &MutationContext,
    email: String,
    name: String,
    role: Option<UserRole>,
) -> Result<User> {
    let id = Uuid::new_v4();
    let now = Utc::now();
    let role = role.unwrap_or_default();

    sqlx::query_as::<_, User>(
        "INSERT INTO users (id, email, name, role, created_at, updated_at) \
         VALUES ($1, $2, $3, $4, $5, $6) RETURNING *",
    )
    .bind(id)
    .bind(&email)
    .bind(&name)
    .bind(role)
    .bind(now)
    .bind(now)
    .fetch_one(ctx.db())
    .await
    .map_err(Into::into)
}

/// Update user with partial fields
#[forge::mutation(timeout = 30, public)]
pub async fn update_user(
    ctx: &MutationContext,
    id: Uuid,
    email: Option<String>,
    name: Option<String>,
    role: Option<UserRole>,
) -> Result<User> {
    sqlx::query_as::<_, User>(
        "UPDATE users SET \
         email = COALESCE($2, email), \
         name = COALESCE($3, name), \
         role = COALESCE($4, role), \
         updated_at = NOW() \
         WHERE id = $1 RETURNING *",
    )
    .bind(id)
    .bind(email)
    .bind(name)
    .bind(role)
    .fetch_one(ctx.db())
    .await
    .map_err(Into::into)
}

/// Delete user by ID
#[forge::mutation(public)]
pub async fn delete_user(ctx: &MutationContext, id: Uuid) -> Result<bool> {
    let result = sqlx::query("DELETE FROM users WHERE id = $1")
        .bind(id)
        .execute(ctx.db())
        .await?;

    Ok(result.rows_affected() > 0)
}
