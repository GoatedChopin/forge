  "db_name": "PostgreSQL",
  "query": "\n        UPDATE users\n        SET\n            email = COALESCE($2, email),\n            name = COALESCE($3, name),\n            role = COALESCE($4, role),\n            updated_at = NOW()\n        WHERE id = $1\n        RETURNING\n            id,\n            email,\n            name,\n            role as \"role: UserRole\",\n            created_at,\n            updated_at\n        ",
