  "db_name": "PostgreSQL",
  "query": "SELECT id, customer_name, title, details,\n                  status as \"status: TicketStatus\",\n                  priority as \"priority: TicketPriority\",\n                  last_note, created_at, updated_at\n         FROM support_tickets\n         ORDER BY\n           CASE status\n             WHEN 'new' THEN 0\n             WHEN 'working' THEN 1\n             ELSE 2\n           END,\n           updated_at DESC",
